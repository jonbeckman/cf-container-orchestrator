{
  "name": "@jonbeckman/cf-container-orchestrator",
  "version": "0.1.0",
  "description": "Orchestrate Cloudflare Containers with fleet management, restart policies, and crash loop protection with a type-safe operator built on Effect-TS.",
  "keywords": [
    "cloudflare",
    "containers",
    "durable-objects",
    "effect",
    "operator",
    "workers"
  ],
  "license": "MIT",
  "author": "Jonathan Beckman <jonathantbeckman@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonbeckman/cf-container-orchestrator.git"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./errors": "./src/errors/index.ts",
    "./types": "./src/types/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.31",
    "effect": "^3.19.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/node": "^25.1.0",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.41.0",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@cloudflare/containers": ">=0.1.0",
    "effect": ">=3.0.0"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
